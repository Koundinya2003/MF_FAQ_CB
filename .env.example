# Copy to .env for local development. Never commit the real .env.

# --- LLM (optional) ---------------------------------------------------------
# Free key from https://openrouter.ai/keys
# Without it FundBot still answers, returning the retrieved passage verbatim
# instead of a rephrased version. Retrieval and citations are unaffected.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Any OpenRouter model id. The default is a free-tier DeepSeek checkpoint;
# check https://openrouter.ai/models?max_price=0 for the current free list.
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Seconds to wait for the model before falling back to the retrieved passage.
# Keep it below the platform function timeout (vercel.json sets maxDuration=30).
LLM_TIMEOUT_SECONDS=12

# Set to 1 to skip the LLM entirely and always return retrieved text.
FUNDBOT_DISABLE_LLM=0

# --- Server -----------------------------------------------------------------
PORT=8000

# Comma-separated browser origins allowed to call the API cross-origin.
# Not needed on Vercel, where the page and the API share an origin.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Number of passages passed to the LLM as context.
RETRIEVAL_TOP_K=3

# Set to 1 to enable POST /api/search, the retrieval-only debug view.
FUNDBOT_DEBUG=0
