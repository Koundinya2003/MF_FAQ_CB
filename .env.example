# Backend (local: copy to .env and export, or pass inline)
OPENAI_API_KEY=sk-your-key-here

# Optional — comma-separated browser origins allowed to call the API directly
# (not needed when using the Netlify /api proxy in production)
ALLOWED_ORIGINS=https://mf-faq.netlify.app,http://localhost:5500

# Backend listen port (default 8000)
PORT=8000

# Frontend override (optional) — set in index.html meta or Netlify env at build time
# API_BASE_URL=https://your-backend.up.railway.app
